# Dependencies
node_modules/

# Build output
# Keep `dist/` unscoped so app/package build output is ignored, but scope
# `build/` and `lib/` to the repo root: source folders may legitimately be
# named `lib` (e.g. apps/client/src/lib).
dist/
/build/
/lib/

# TypeScript build info
*.tsbuildinfo

# Vite cache
.vite/

# TanStack Router cache
.tanstack/

# Test coverage
coverage/
coverage-reports/
spec-reports/
test-reports/

# Environment files
.env
.env.local
.env.*.local

# IDE and editor state
.vscode/
.idea/
docs/.obsidian/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Local scratch and agent tooling
.scratch/
.agents/
skills-lock.json

# Docker volumes
docker-data/
