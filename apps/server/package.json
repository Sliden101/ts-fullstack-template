{
  "name": "@repo/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "NestJS + Mercurius + Drizzle + Effect backend.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "tsx --env-file=../../.env src/main.ts",
    "start:dev": "tsx --env-file=../../.env watch src/main.ts",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "seed:admin": "tsx --env-file=../../.env scripts/seed-admin.ts",
    "load:auth": "tsx --env-file=../../.env scripts/load-auth.ts",
    "test:e2e": "tsx --env-file=../../.env scripts/e2e-auth.ts",
    "test:e2e:users": "tsx --env-file=../../.env scripts/e2e-users.ts",
    "test:e2e:pokemon": "tsx --env-file=../../.env scripts/e2e-pokemon.ts"
  },
  "author": "Sliden101",
  "license": "MIT",
  "dependencies": {
    "@nest-native/drizzle": "^0.5.0",
    "@nestjs/common": "^12.0.2",
    "@nestjs/core": "^12.0.2",
    "@nestjs/graphql": "^14.0.0",
    "@nestjs/mercurius": "^14.0.0",
    "@nestjs/platform-fastify": "^12.0.2",
    "@repo/contracts": "*",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.2",
    "effect": "4.0.0-rc.115",
    "graphql": "^16.14.2",
    "mercurius": "^16.10.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.3",
    "@repo/eslint-config": "*",
    "@repo/tsconfig": "*",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.1",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
