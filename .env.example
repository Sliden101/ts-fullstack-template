# Human-readable application name (used by auth emails, logs, and the client title).
APP_NAME=Fullstack Template

# --- Server -----------------------------------------------------------------
# Port the API server listens on. The client dev proxy targets this port.
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Comma-separated list of origins allowed to call the API.
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

# Public base URL of this API server (used by better-auth).
BETTER_AUTH_URL=http://localhost:3001
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# Seed admin account (used by `npm run seed:admin`).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
DEFAULT_ROLE=user

# Upstream base URL for the example PokéAPI feature.
POKEAPI_BASE_URL=https://pokeapi.co/api/v2

# --- Client -----------------------------------------------------------------
# Base path the client uses for API calls in production. Leave empty in dev to
# use the Vite proxy.
VITE_API_URL=
# Dev-only proxy target for /graphql and /api.
VITE_DEV_API_TARGET=http://localhost:3001
